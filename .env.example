# Vercel production env template
#
# Do not commit real secrets here.
# In Vercel, paste the real values into Project Settings -> Environment Variables.

NODE_ENV=production
PORT=3000
PROD_LINK=https://<YOUR_VERCEL_DOMAIN>
# Neon Postgres
# Runtime should use the pooled URL.
DATABASE_URL=<DB_LINK>

# Prisma migrations should use the direct/non-pooler URL.
DATABASE_URL_UNPOOLED=<DB_LINK>

# Vercel web functions should not run BullMQ schedulers.
# Use a separate long-running worker with Redis for reminders/reviews.
SCHEDULER_ENABLED=false
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Telegram
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
TELEGRAM_WEBHOOK_SECRET=

# OpenAI - optional. AI features fail gracefully without this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=2
OPENAI_CIRCUIT_FAILURE_THRESHOLD=5
OPENAI_CIRCUIT_RESET_MS=60000
AI_INPUT_COST_PER_1M=0.75
AI_OUTPUT_COST_PER_1M=4.50

# Premium plan seed values
PREMIUM_MONTHLY_PRICE_USD=10
PREMIUM_YEARLY_PRICE_USD=99

# Optional 100% coupon created by prisma db seed when set
COUPON_CODE_FREE=

# Crypto payments
PAYMENT_RECEIVER_ETHEREUM_ADDRESS=<ETHEREUM_RECEIVER_ADDRESS>
PAYMENT_RECEIVER_ARBITRUM_ADDRESS=<ARBITRUM_RECEIVER_ADDRESS>
PAYMENT_RECEIVER_BSC_ADDRESS=
PAYMENT_CHAIN_ETHEREUM_ENABLED=true
PAYMENT_CHAIN_ARBITRUM_ENABLED=true
PAYMENT_CHAIN_BSC_ENABLED=false
ETHERSCAN_API_KEY=<ETHERSCAN_API_KEY>
PAYMENT_CHECKOUT_EXPIRES_MINUTES=30
