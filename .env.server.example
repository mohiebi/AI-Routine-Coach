# ─────────────────────────────────────────────────────────────────────────────
# AI Routine Coach — Self-hosted server .env
# Copy this file to .env and fill in every value marked <REQUIRED>.
# Lines with a default are optional — only change them if you need to.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────

NODE_ENV=production

# The port NestJS listens on. Nginx/Caddy should proxy to this.
PORT=3000

# Your server's public HTTPS URL (no trailing slash).
# Telegram will POST webhook updates to <PROD_LINK>/telegram/webhook.
# ⚠️  Must be HTTPS — Telegram rejects plain HTTP webhooks.
#     If you don't have a domain yet, leave this empty and the bot
#     will fall back to long-polling automatically.
PROD_LINK=https://<YOUR_DOMAIN_OR_IP>

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────

# <REQUIRED> — full Postgres connection string.
# On a local Postgres: postgresql://postgres:<PASSWORD>@localhost:5432/routine
DATABASE_URL=postgresql://<USER>:<PASSWORD>@localhost:5432/routine

# Only needed if you use a connection pooler (e.g. PgBouncer).
# On a plain self-hosted Postgres, leave this empty or the same as DATABASE_URL.
DATABASE_URL_UNPOOLED=

# ── Redis (BullMQ scheduler) ──────────────────────────────────────────────────

# <REQUIRED for reminders> — Redis runs on the same server, so localhost works.
REDIS_HOST=localhost
REDIS_PORT=6379

# Set a Redis password if you configured one in /etc/redis/redis.conf (requirepass).
# Leave empty if Redis is only accessible locally with no auth.
REDIS_PASSWORD=

# On a real server the scheduler CAN run. Set to true to enable morning
# reminders, evening check-ins, weekly & monthly reviews.
SCHEDULER_ENABLED=true

# ── Telegram ──────────────────────────────────────────────────────────────────

# <REQUIRED> — get this from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=<YOUR_BOT_TOKEN>

TELEGRAM_BOT_ENABLED=true

# Optional shared secret Telegram sends in X-Telegram-Bot-Api-Secret-Token header.
# Set any random string here and it will be verified on every webhook call.
# Generate one with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ── OpenAI (AI features) ──────────────────────────────────────────────────────

# <REQUIRED for AI features> — get from platform.openai.com/api-keys
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# Model to use. gpt-4o-mini is fast and cheap; gpt-4o is smarter but pricier.
OPENAI_MODEL=gpt-4o-mini

# How long to wait for OpenAI before giving up (milliseconds).
OPENAI_TIMEOUT_MS=20000

# How many times to retry a failed OpenAI call before showing an error.
OPENAI_MAX_RETRIES=2

# Circuit breaker: after this many consecutive failures, stop calling OpenAI
# for OPENAI_CIRCUIT_RESET_MS milliseconds to avoid hammering a broken API.
OPENAI_CIRCUIT_FAILURE_THRESHOLD=5
OPENAI_CIRCUIT_RESET_MS=60000

# Cost tracking (per 1M tokens) — used for internal logging only, not billing.
AI_INPUT_COST_PER_1M=0.15
AI_OUTPUT_COST_PER_1M=0.60

# ── Premium plans ─────────────────────────────────────────────────────────────

# Prices shown in the bot and used when seeding the DB.
# Change these before running `npx prisma db seed` for the first time.
PREMIUM_MONTHLY_PRICE_USD=10
PREMIUM_YEARLY_PRICE_USD=99

# Optional: if set, prisma db seed will create a 100%-off coupon with this code.
# Use it to activate your own account for free during testing.
# Example: COUPON_CODE_FREE=FOUNDER2025
COUPON_CODE_FREE=

# ── Crypto payments ───────────────────────────────────────────────────────────

# <REQUIRED if accepting crypto> — your EVM wallet address that receives payments.
# Must be a valid 0x... address. Users send USDT/USDC here.
PAYMENT_RECEIVER_ETHEREUM_ADDRESS=
PAYMENT_RECEIVER_ARBITRUM_ADDRESS=
PAYMENT_RECEIVER_BSC_ADDRESS=

# Toggle each chain on/off independently.
# Arbitrum is cheapest for users (low gas fees) — recommended to enable first.
PAYMENT_CHAIN_ARBITRUM_ENABLED=true
PAYMENT_CHAIN_ETHEREUM_ENABLED=true
PAYMENT_CHAIN_BSC_ENABLED=false

# <REQUIRED if accepting crypto> — used to verify transactions on-chain.
# Free key from https://etherscan.io/myapikey  (also works for Arbitrum).
ETHERSCAN_API_KEY=<YOUR_ETHERSCAN_API_KEY>

# How many minutes a checkout session stays valid before it expires.
PAYMENT_CHECKOUT_EXPIRES_MINUTES=30
