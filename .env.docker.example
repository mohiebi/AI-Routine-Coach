# ─────────────────────────────────────────────────────────────────────────────
# AI Routine Coach — Docker / docker-compose.prod.yml env template
#
# When running with docker-compose.prod.yml, services talk to each other
# using Docker service names (postgres, redis) — NOT localhost.
#
# Copy to .env and fill in every value marked <REQUIRED>.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# Your server's public HTTPS URL (no trailing slash).
# Used to register the Telegram webhook. Must be HTTPS.
# Leave empty to use long-polling (fine if you don't have a domain yet).
PROD_LINK=https://<YOUR_DOMAIN>

# ── Database ──────────────────────────────────────────────────────────────────

# <REQUIRED> — "postgres" is the Docker service name, not localhost.
# DB_PASSWORD must match the DB_PASSWORD you set below.
DATABASE_URL=postgresql://routine:<DB_PASSWORD>@postgres:5432/routine

# <REQUIRED> — Postgres password. Used by both the postgres container and the
# DATABASE_URL above. Pick any strong password.
DB_PASSWORD=<STRONG_PASSWORD>

# Not needed when Postgres runs without a pooler (standard docker-compose setup)
DATABASE_URL_UNPOOLED=

# ── Redis ─────────────────────────────────────────────────────────────────────

# "redis" is the Docker service name, not localhost.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Scheduler runs inside the app container — no need to disable it here.
SCHEDULER_ENABLED=true

# ── Telegram ──────────────────────────────────────────────────────────────────

# <REQUIRED>
TELEGRAM_BOT_TOKEN=<YOUR_BOT_TOKEN>
TELEGRAM_BOT_ENABLED=true

# Optional: random secret Telegram sends on every webhook call for verification.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ── OpenAI ────────────────────────────────────────────────────────────────────

# <REQUIRED for AI features>
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=2
OPENAI_CIRCUIT_FAILURE_THRESHOLD=5
OPENAI_CIRCUIT_RESET_MS=60000
AI_INPUT_COST_PER_1M=0.15
AI_OUTPUT_COST_PER_1M=0.60

# ── Premium plans ─────────────────────────────────────────────────────────────

PREMIUM_MONTHLY_PRICE_USD=10
PREMIUM_YEARLY_PRICE_USD=99

# Optional 100% coupon created on first `prisma db seed`. E.g. FOUNDER2025
COUPON_CODE_FREE=

# ── Crypto payments ───────────────────────────────────────────────────────────

# <REQUIRED if accepting crypto>
PAYMENT_RECEIVER_ETHEREUM_ADDRESS=
PAYMENT_RECEIVER_ARBITRUM_ADDRESS=
PAYMENT_RECEIVER_BSC_ADDRESS=

PAYMENT_CHAIN_ARBITRUM_ENABLED=true
PAYMENT_CHAIN_ETHEREUM_ENABLED=true
PAYMENT_CHAIN_BSC_ENABLED=false

# <REQUIRED if accepting crypto> — free at etherscan.io/myapikey
ETHERSCAN_API_KEY=<YOUR_ETHERSCAN_API_KEY>

PAYMENT_CHECKOUT_EXPIRES_MINUTES=30
